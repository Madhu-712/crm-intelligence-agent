# Google AI Studio API Key (Free Tier - No Credit Card Required)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Gemini Model Target
GEMINI_MODEL=gemini-3.6-flash

# Google Cloud Project & BigQuery Sandbox Configuration
GCP_PROJECT=your-actual-gcp-project-id
BQ_DATASET=crm_data
BQ_TABLE=leads

# Application Port (Optional / Cloud Run deployment)
PORT=8501
